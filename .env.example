# Plantilla de variables de entorno. SIN SECRETOS.
# Copiar a `.env.local` (ignorado por Git) y rellenar.
#
# Recordatorio: las variables NEXT_PUBLIC_* se incrustan en el bundle del
# navegador durante el build. NUNCA pueden contener un secreto, y deben estar
# definidas ANTES de construir.

# ─── Núcleo ──────────────────────────────────────────────────────────────
# URL pública del sitio, sin barra final. Se usa para canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interruptor de indexación. Con cualquier valor distinto de "true" el sitio
# se sirve con `noindex` y robots.txt bloquea todo.
# Poner en "true" SOLO cuando el dominio definitivo esté apuntando al sitio.
NEXT_PUBLIC_INDEXABLE=false


# ─── Bloqueado hasta que el cliente contrate los servicios ────────────────
# Ninguna de estas se usa todavía: el sistema de cotización con persistencia
# está diseñado pero no conectado. Ver AUDITORIA_Y_PLAN_AMPARGO.md.

# Base de datos (Supabase / Neon)
# DATABASE_URL=

# Almacenamiento de objetos privado para las fotos de referencia (R2 / Supabase Storage)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Correo transaccional del formulario de cotización (app/api/quote/route.ts,
# lib/mail.ts) — el canal "Email" de DeliveryChannelSelector, con fotos
# adjuntas de verdad. Sin RESEND_API_KEY el canal queda deshabilitado de
# forma honesta (el formulario solo ofrece WhatsApp); no hace falta ninguna
# otra variable de este bloque para que funcione.
#
# RESEND_API_KEY=            # Clave de resend.com — con esto sola ya envía,
#                             # usando el remitente de pruebas de Resend.
# QUOTE_INBOX_EMAIL=          # A dónde llegan las solicitudes. Por defecto,
#                             # contacto@ampargo.com — solo hace falta si
#                             # se quiere entregar a otro buzón.
# EMAIL_FROM_ADDRESS=         # Opcional. Solo tiene efecto tras verificar un
#                             # dominio propio en Resend — hasta entonces se
#                             # envía desde onboarding@resend.dev igual.

# Secretos de seguridad (generar con: openssl rand -hex 32)
# IP_HASH_SALT=
# FORM_NONCE_SECRET=
# MAINTENANCE_TOKEN=
